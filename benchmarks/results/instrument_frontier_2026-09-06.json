        "case_id": "catalog_partition_l3",
        "requirements": [
          {
            "requirement_id": "R1",
            "text": "Catalog publishes independent JSON-like non-null records by tenant and SKU. get returns the latest published value for that tenant/SKU regardless of the order other tenants or SKUs are queried. Unknown records raise KeyError. Public method signatures remain unchanged."
          },
          {
            "requirement_id": "R2",
            "text": "A publish becomes visible on the next get even while earlier results remain within cache lifetime. Advancing time beyond cache lifetime must not alter the logical record. There is no required internal cache key or revision allocation scheme."
          },
          {
            "requirement_id": "R3",
            "text": "Caller mutations to published records and to values returned by get must not change subsequently returned records. Inputs to this task are valid strings and JSON-like values; times are nondecreasing."
          }
        ],
        "requirement_commitment": "888618e9d710b0e8b3d4e9527f0ec10086e3161a99ee345d352577986998c57d",
        "assertion_count": 2,
        "alignment_commitment": "7ed7d1a4f4bd18626286641999b38db1284894727673d9258f44886c3c9fbdbf",
        "executable_case": {
          "case_id": "catalog_partition_l3",
          "task": "Repair the supplied source files to satisfy every public requirement below.\nPreserve public signatures unless a requirement explicitly says otherwise.\n\n[R1] Catalog publishes independent JSON-like non-null records by tenant and SKU. get returns the latest published value for that tenant/SKU regardless of the order other tenants or SKUs are queried. Unknown records raise KeyError. Public method signatures remain unchanged.\n[R2] A publish becomes visible on the next get even while earlier results remain within cache lifetime. Advancing time beyond cache lifetime must not alter the logical record. There is no required internal cache key or revision allocation scheme.\n[R3] Caller mutations to published records and to values returned by get must not change subsequently returned records. Inputs to this task are valid strings and JSON-like values; times are nondecreasing.",
          "files": {
            "catalog/__init__.py": "",
            "catalog/storage.py": "from copy import deepcopy\n\nclass RecordStore:\n    def __init__(self):\n        self.records = {}\n        self.revisions = {}\n\n    def write(self, tenant, sku, value):\n        key = (tenant, sku)\n        self.revisions[key] = self.revisions.get(key, 0) + 1\n        self.records[key] = deepcopy(value)\n\n    def revision(self, tenant, sku):\n        return self.revisions[(tenant, sku)]\n\n    def load(self, tenant, sku):\n        return deepcopy(self.records[(tenant, sku)])\n",
            "catalog/cache.py": "from copy import deepcopy\n\nclass TimedCache:\n    def __init__(self, lifetime):\n        self.lifetime = lifetime\n        self.entries = {}\n\n    def read(self, key, now):\n        entry = self.entries.get(key)\n        if entry is None or now >= entry[0]:\n            return None\n        return deepcopy(entry[1])\n\n    def write(self, key, value, now):\n        self.entries[key] = (now + self.lifetime, deepcopy(value))\n",
            "catalog/service.py": "from .storage import RecordStore\nfrom .cache import TimedCache\n\nclass Catalog:\n    def __init__(self, lifetime=30):\n        self.store = RecordStore()\n        self.cache = TimedCache(lifetime)\n\n    def publish(self, tenant, sku, value):\n        self.store.write(tenant, sku, value)\n\n    def get(self, tenant, sku, now):\n        version = self.store.revision(tenant, sku)\n        key = (sku, version)\n        result = self.cache.read(key, now)\n        if result is None:\n            result = self.store.load(tenant, sku)\n            self.cache.write(key, result, now)\n        return result\n",
            "catalog/presentation.py": "def format_price(record):\n    return '{:.2f}'.format(record['price'])\n\ndef stable_listing(records):\n    return sorted(records, key=lambda row: row.get('label', ''))\n"
          },
