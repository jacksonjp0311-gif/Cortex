        {
          "case_id": "equal_timestamp_sync",
          "files": {
            "cursor.py": "class Cursor:\n    def __init__(self): self.time=-1\n",
            "files.py": "class FileStore:\n    def __init__(self): self.data={}\n    def put(self,name,value): self.data[name]=value\n",
            "ordering.py": "def chronological(rows): return sorted(rows)\n",
            "service.py": "from files import FileStore\nfrom cursor import Cursor\nclass Sync:\n    def __init__(self): self.files=FileStore(); self.cursor=Cursor()\n    def run(self,records):\n        pending=[r for r in records if r[0]>self.cursor.time]\n        for stamp,name,value in sorted(pending):\n            self.files.put(name,value)\n            self.cursor.time=stamp\n        return dict(self.files.data)\n"
          },
          "model_visible_files": [
            "TASK.md",
            "cursor.py",
            "files.py",
            "ordering.py",
            "service.py"
          ],
          "private_evaluator_commitment": "b219b465bd0d7436c72984641d98b765c239b0ee6c1b4c11a64beb472b2e3011",
          "task": "Repair the supplied source files to satisfy every public requirement below.\nPreserve public signatures unless a requirement explicitly says otherwise.\n\n[R1] Sync.run(records) receives (nonnegative timestamp,name,string value) records and returns current name-to-value state. New names sharing a timestamp with earlier calls must not be lost. Each name is delivered in increasing timestamp order, repeated identical records may recur, and timestamps across names may differ. The most recent value per name must remain visible; replayed older records must not overwrite it. No watermark representation is required."
        },
        {
          "case_id": "checkpoint_replay_boundary",
          "files": {
            "formatting.py": "def keys(values): return sorted(values)\n",
            "journal.py": "class Journal:\n    def __init__(self): self.rows=[]\n    def append(self,key,value): self.rows.append((key,value))\n",
            "service.py": "from snapshots import Snapshot\nfrom journal import Journal\nclass Database:\n    def __init__(self): self.values={}; self.journal=Journal()\n    def put(self,key,value):\n        self.values[key]=value\n        self.journal.append(key,value)\n    def checkpoint(self): return Snapshot(dict(self.values),len(self.journal.rows))\n    def restore(self,snapshot):\n        restored=dict(snapshot.values)\n        for key,value in self.journal.rows[snapshot.position+1:]: restored[key]=value\n        return restored\n",
            "snapshots.py": "class Snapshot:\n    def __init__(self,values,position): self.values=values; self.position=position\n"
          },
          "model_visible_files": [
            "TASK.md",
            "formatting.py",
            "journal.py",
            "service.py",
            "snapshots.py"
          ],
          "private_evaluator_commitment": "8178256d5bb08cb73e161f3fcb59c040d0778b3af58fcddc6c069c1dbdeb1a94",
          "task": "Repair the supplied source files to satisfy every public requirement below.\nPreserve public signatures unless a requirement explicitly says otherwise.\n\n[R1] Database.put records string values. checkpoint returns an opaque immutable-in-use snapshot; restore(snapshot) reconstructs the latest state from that snapshot and subsequent writes without changing live state. It must work for an empty snapshot, for no writes after a checkpoint, and for one or several subsequent writes including overwrites. Snapshot position conventions are not part of the public contract."
        },
        {
          "case_id": "superseded_job_delivery",
          "files": {
            "encoding.py": "def encode(row): return repr(row)\n",
            "queueing.py": "class Queue:\n    def __init__(self): self.rows=[]\n    def push(self,row): self.rows.append(row)\n    def take_all(self):\n        rows,self.rows=self.rows,[]\n        return rows\n",
            "service.py": "from queueing import Queue\nclass Worker:\n    def __init__(self): self.queue=Queue(); self.generation={}; self.completed=[]\n    def schedule(self,name,payload):\n        self.generation[name]=self.generation.get(name,0)+1\n        self.queue.push((name,self.generation[name],payload))\n    def drain(self):\n        for name,generation,payload in self.queue.take_all():\n            self.completed.append((name,payload))\n        return list(self.completed)\n"
          },
          "model_visible_files": [
            "TASK.md",
            "encoding.py",
            "queueing.py",
            "service.py"
          ],
          "private_evaluator_commitment": "81fae9f56f389533afcd6c67180faf6fe79a4fc15ac1da592eec79febec27265",
          "task": "Repair the supplied source files to satisfy every public requirement below.\nPreserve public signatures unless a requirement explicitly says otherwise.\n\n[R1] Worker.schedule(name,payload) replaces pending work for that name. drain processes only the latest pending payload per name in the order of those latest schedule calls and returns cumulative completed (name,payload) pairs. A later schedule after a drain is new work even for a previously completed name. Empty drains add nothing. Inputs are strings. Pending queue storage is not prescribed."
        },
        {
          "case_id": "disjoint_transaction_merge",
          "files": {
            "records.py": "class Records:\n    def __init__(self): self.values={}\n",
            "service.py": "from records import Records\nclass Transactions:\n    def __init__(self): self.records=Records()\n    def begin(self): return dict(self.records.values)\n    def commit(self,base,changes):\n        for key,value in changes.items():\n            if self.records.values.get(key)!=base.get(key): return False\n        self.records.values=dict(base)\n        self.records.values.update(changes)\n        return True\n",
            "view.py": "def ordered(values): return sorted(values.items())\n"
          },
