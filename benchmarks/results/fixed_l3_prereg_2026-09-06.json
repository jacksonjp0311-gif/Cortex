        {
          "case_id": "retry_after_commit",
          "files": {
            "ledger.py": "class Ledger:\n    def __init__(self): self.total=0\n    def apply(self,event_id,amount): self.total+=amount\n",
            "report.py": "def currency(n): return str(n)\n",
            "service.py": "from ledger import Ledger\nfrom transport import checkpoint\nclass Processor:\n    def __init__(self):\n        self.ledger=Ledger()\n        self.done={}\n    def process(self, event_id, amount, fault=None):\n        if event_id in self.done:\n            if self.done[event_id] != amount: raise ValueError('conflicting event')\n            return self.ledger.total\n        checkpoint(fault, 'before')\n        self.ledger.apply(event_id,amount)\n        checkpoint(fault, 'after')\n        self.done[event_id]=amount\n        return self.ledger.total\n",
            "transport.py": "def checkpoint(fault,phase):\n    if fault==phase: raise RuntimeError('transport fault')\n"
          },
          "model_visible_files": [
            "TASK.md",
            "ledger.py",
            "report.py",
            "service.py",
            "transport.py"
          ],
          "private_evaluator_commitment": "f08a70ebdb8e2dd923d5d760f5a48f7512ba78292496c28c0510a9b6936b6c86",
          "task": "Repair the supplied source files to satisfy every public requirement below.\nPreserve public signatures unless a requirement explicitly says otherwise.\n\n[R1] Processor.process(event_id,amount,fault=None) credits integer amounts exactly once per event ID. A fault before application applies nothing and a retry must still apply; a fault after application raises RuntimeError but a retry must not credit again. Reusing an applied ID with a different amount raises ValueError without altering total, including after an after-application fault. ledger.total is the observable total. Valid inputs only; no specified internal receipt strategy."
        },
        {
          "case_id": "atomic_projection_offset",
          "files": {
            "metrics.py": "def count(values): return sum(map(len,values.values()))\n",
            "reducer.py": "def apply(values,key,delta):\n    if not isinstance(delta,int) or isinstance(delta,bool): raise ValueError('delta')\n    values.setdefault(key,[]).append(delta)\n",
            "service.py": "from reducer import apply\nfrom state import State\nclass Projector:\n    def __init__(self): self.state=State()\n    def consume(self,offset,events):\n        if offset<=self.state.offset: return dict(self.state.values)\n        working=self.state.values.copy()\n        for key,delta in events: apply(working,key,delta)\n        self.state.values=working\n        self.state.offset=offset\n        return {k:list(v) for k,v in working.items()}\n",
            "state.py": "class State:\n    def __init__(self): self.offset=-1; self.values={}\n"
          },
          "model_visible_files": [
            "TASK.md",
            "metrics.py",
            "reducer.py",
            "service.py",
            "state.py"
          ],
          "private_evaluator_commitment": "d6a91bc71921587844549d87b27fc58c1b259954f6fe7ba6d407ccfaa5054d58",
          "task": "Repair the supplied source files to satisfy every public requirement below.\nPreserve public signatures unless a requirement explicitly says otherwise.\n\n[R1] Projector.consume(offset,events) applies a newer integer offset atomically, appending each integer delta (bool invalid) to its key history. Invalid delta raises ValueError with histories and offset unchanged. Replayed or older offsets are ignored, returning a deep snapshot; successful results are deep snapshots too. state.offset and state.values are observable state. No particular copy or validation order is prescribed."
        },
        {
          "case_id": "superseded_expiry",
          "files": {
            "clockwork.py": "def is_expired(deadline,now): return deadline<=now\n",
            "display.py": "def status(active): return \"active\" if active else \"expired\"\n",
            "pool.py": "class Pool:\n    def __init__(self): self.current={}; self.pending=[]\n",
            "service.py": "from clockwork import is_expired\nfrom pool import Pool\nclass Reservations:\n    def __init__(self): self.pool=Pool(); self.next_id=0\n    def reserve(self,name,now,ttl):\n        self.next_id+=1\n        token=self.next_id\n        self.pool.current[name]=(token,now+ttl)\n        self.pool.pending.append((name,token,now+ttl))\n        return token\n    def sweep(self,now):\n        remaining=[]\n        for name,token,deadline in self.pool.pending:\n            if is_expired(deadline,now): self.pool.current.pop(name,None)\n            else: remaining.append((name,token,deadline))\n        self.pool.pending=remaining\n    def active(self,name): return name in self.pool.current\n"
          },
          "model_visible_files": [
            "TASK.md",
            "clockwork.py",
            "display.py",
            "pool.py",
            "service.py"
          ],
          "private_evaluator_commitment": "a189e0705426489aa42d42c630feb007f00ae49496c9ad151534f72667298ffd",
          "task": "Repair the supplied source files to satisfy every public requirement below.\nPreserve public signatures unless a requirement explicitly says otherwise.\n\n[R1] Reservations.reserve(name,now,ttl) replaces any earlier reservation of that name and returns a distinct positive token. sweep(now) expires the latest reservation exactly at its deadline, not earlier because an older reservation expired. Different names are independent; repeated sweeps are harmless. active(name) reports presence after sweeps. Times are nondecreasing and ttl positive. Queue strategy is unspecified."
        },
        {
          "case_id": "catalog_partition_l3",
          "files": {
            "catalog/__init__.py": "",
            "catalog/cache.py": "from copy import deepcopy\n\nclass TimedCache:\n    def __init__(self, lifetime):\n        self.lifetime = lifetime\n        self.entries = {}\n\n    def read(self, key, now):\n        entry = self.entries.get(key)\n        if entry is None or now >= entry[0]:\n            return None\n        return deepcopy(entry[1])\n\n    def write(self, key, value, now):\n        self.entries[key] = (now + self.lifetime, deepcopy(value))\n",
            "catalog/presentation.py": "def format_price(record):\n    return '{:.2f}'.format(record['price'])\n\ndef stable_listing(records):\n    return sorted(records, key=lambda row: row.get('label', ''))\n",
            "catalog/service.py": "from .storage import RecordStore\nfrom .cache import TimedCache\n\nclass Catalog:\n    def __init__(self, lifetime=30):\n        self.store = RecordStore()\n        self.cache = TimedCache(lifetime)\n\n    def publish(self, tenant, sku, value):\n        self.store.write(tenant, sku, value)\n\n    def get(self, tenant, sku, now):\n        version = self.store.revision(tenant, sku)\n        key = (sku, version)\n        result = self.cache.read(key, now)\n        if result is None:\n            result = self.store.load(tenant, sku)\n            self.cache.write(key, result, now)\n        return result\n",
            "catalog/storage.py": "from copy import deepcopy\n\nclass RecordStore:\n    def __init__(self):\n        self.records = {}\n        self.revisions = {}\n\n    def write(self, tenant, sku, value):\n        key = (tenant, sku)\n        self.revisions[key] = self.revisions.get(key, 0) + 1\n        self.records[key] = deepcopy(value)\n\n    def revision(self, tenant, sku):\n        return self.revisions[(tenant, sku)]\n\n    def load(self, tenant, sku):\n        return deepcopy(self.records[(tenant, sku)])\n"
          },
          "model_visible_files": [
